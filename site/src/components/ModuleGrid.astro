---
import { MODULES } from '../data/modules';
import { crateUrl, docsRsUrl } from '../config';
---

<div class="ck-modules-wrap">
<ul class="ck-modules">
	{
		MODULES.map((m) => (
			<li class="ck-module">
				<h3>{m.title}</h3>
				<p>{m.scope}</p>
				<ul class="ck-crates">
					{m.crates.map((c) => (
						<li>
							<a href={crateUrl(c)} class="ck-crate">
								<code>{c}</code>
							</a>
							<a href={docsRsUrl(c)} class="ck-docsrs">
								API<span class="sr-only"> reference for {c}</span>
							</a>
						</li>
					))}
				</ul>
			</li>
		))
	}
</ul>
</div>

<style>
	/* Columns follow the grid's own width (container query), so a last card left alone in its
	   row can span the row instead of leaving empty cells. */
	.ck-modules-wrap {
		container: ck-modules / inline-size;
	}
	.ck-modules {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--ck-border);
		border-left: 1px solid var(--ck-border);
	}
	.ck-module {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--ck-space-3);
		padding: var(--ck-space-6);
		background: var(--ck-surface);
		border-right: 1px solid var(--ck-border);
		border-bottom: 1px solid var(--ck-border);
	}
	/* Grip at the corner node. */
	.ck-module::before {
		content: '';
		position: absolute;
		top: -1px;
		left: -1px;
		width: 7px;
		height: 7px;
		background: var(--ck-accent);
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
		line-height: 1.3;
	}
	p {
		margin: 0;
		max-width: 40rem;
		color: var(--ck-muted);
		font-size: var(--sl-text-sm);
		flex: 1;
	}
	.ck-crates {
		display: flex;
		flex-wrap: wrap;
		gap: var(--ck-space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.ck-crates li {
		display: inline-flex;
		border: 1px solid var(--ck-border);
		border-radius: var(--ck-radius);
	}
	.ck-crates a {
		padding: 0.125rem 0.5rem;
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}
	.ck-crate code {
		color: var(--ck-text);
		font-size: var(--sl-text-xs);
	}
	.ck-docsrs {
		border-left: 1px solid var(--ck-border);
		font-family: var(--__sl-font-mono);
		color: var(--ck-accent);
	}
	.ck-crates a:hover {
		background: var(--ck-raised);
	}

	@container ck-modules (min-width: 40rem) {
		.ck-modules {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@container ck-modules (min-width: 62rem) {
		.ck-modules {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	/* A last card alone in its row spans it: text at reading width, crates beside it. */
	@container ck-modules (min-width: 40rem) and (max-width: 61.99rem) {
		.ck-module:last-child:nth-child(odd) {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-rows: auto 1fr;
			column-gap: var(--ck-space-8);
		}
		.ck-module:last-child:nth-child(odd) .ck-crates {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: end;
			flex-wrap: nowrap;
		}
	}
	@container ck-modules (min-width: 62rem) {
		.ck-module:last-child:nth-child(3n + 1) {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-rows: auto 1fr;
			column-gap: var(--ck-space-8);
		}
		.ck-module:last-child:nth-child(3n + 1) .ck-crates {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: end;
			flex-wrap: nowrap;
		}
	}
</style>
