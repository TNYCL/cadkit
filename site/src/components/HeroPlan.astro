---
// Hero drawing: the synthetic sample plan, rendered at build time by cadkit-wasm
// (scripts/hero.mjs), drawn in once with a stroke-dashoffset reveal.
import plan from '../generated/hero-plan.json';

const kb = Math.round(plan.bytes / 1024);
---

<figure class="ck-hero-plan">
	<div class="ck-sheet">
		<span class="ck-corner ck-corner--tl" aria-hidden="true"></span>
		<span class="ck-corner ck-corner--br" aria-hidden="true"></span>
		<Fragment set:html={plan.svg} />
	</div>
	<figcaption class="ck-readout">
		<dl>
			<div><dt>File</dt><dd>{plan.file}</dd></div>
			<div><dt>Format</dt><dd>{plan.format.toUpperCase()} {plan.version}</dd></div>
			<div><dt>Entities</dt><dd>{plan.entities}</dd></div>
			<div><dt>Layers</dt><dd>{plan.layers}</dd></div>
			<div><dt>Units</dt><dd>{plan.units}</dd></div>
		</dl>
		<p>
			Rendered at build time by <code>{plan.renderer}</code>.{' '}
			<a href={plan.href} download>Download the DXF<span class="sr-only"> sample plan</span></a>{' '}
			<span class="ck-size">({kb} KB)</span>
		</p>
	</figcaption>
</figure>

<style>
	.ck-hero-plan {
		margin: 0;
	}
	.ck-sheet {
		position: relative;
		padding: var(--ck-space-4);
		border: 1px solid var(--ck-border);
		background: color-mix(in srgb, var(--ck-surface) 88%, transparent);
	}
	.ck-corner {
		position: absolute;
		width: 7px;
		height: 7px;
		background: var(--ck-accent);
	}
	.ck-corner--tl {
		top: -4px;
		left: -4px;
	}
	.ck-corner--br {
		right: -4px;
		bottom: -4px;
	}

	.ck-sheet :global(.ck-plan) {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	/* Stroke widths in drawing units (metres): about 1 CSS px at the rendered sizes below. */
	.ck-sheet :global([data-layer]) {
		stroke: var(--ck-muted);
		stroke-width: 0.042;
	}
	.ck-sheet :global([data-layer='WALLS']) {
		stroke: var(--ck-text);
		stroke-width: 0.05;
	}
	@media (min-width: 40rem) {
		.ck-sheet :global([data-layer]) {
			stroke-width: 0.026;
		}
		.ck-sheet :global([data-layer='WALLS']) {
			stroke-width: 0.034;
		}
	}
	@media (min-width: 64rem) {
		.ck-sheet :global([data-layer]) {
			stroke-width: 0.03;
		}
		.ck-sheet :global([data-layer='WALLS']) {
			stroke-width: 0.04;
		}
	}
	.ck-sheet :global([data-layer='WALLS'] path) {
		fill: color-mix(in srgb, var(--ck-text) 14%, transparent);
	}
	.ck-sheet :global([data-layer='DOORS']),
	.ck-sheet :global([data-layer='WINDOWS']) {
		stroke: var(--ck-accent);
	}
	.ck-sheet :global([data-layer='DIMENSIONS']) {
		stroke: var(--ck-redline);
	}
	.ck-sheet :global([data-layer='GRID']) {
		stroke: var(--ck-border);
	}
	.ck-sheet :global(text) {
		stroke: none;
		fill: var(--ck-muted);
		font-family: var(--__sl-font-mono);
	}
	.ck-sheet :global([data-layer='TEXT'] text) {
		fill: var(--ck-text);
	}
	.ck-sheet :global([data-layer='DIMENSIONS'] text) {
		fill: var(--ck-redline);
	}

	/*
	 * Line-draw reveal, once; reduced motion shows the finished drawing. Every shape has
	 * pathLength="1". The dash is 2 long (not 1) because browsers approximate arc lengths: offset
	 * 2 hides the path, 1 draws its nominal length and 0 guarantees the whole stroke is solid.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.ck-sheet :global([pathLength]) {
			stroke-dasharray: 2;
			stroke-dashoffset: 2;
			animation: ck-draw 1.2s var(--ck-ease) forwards;
		}
		.ck-sheet :global([data-layer='WALLS'] path) {
			fill-opacity: 0;
			animation:
				ck-draw 1.2s var(--ck-ease) forwards,
				ck-fill 0.4s var(--ck-ease) 1s forwards;
		}
		.ck-sheet :global([data-layer='GRID'] [pathLength]) {
			animation-duration: 0.9s;
		}
		.ck-sheet :global([data-layer='WINDOWS'] [pathLength]),
		.ck-sheet :global([data-layer='DOORS'] [pathLength]) {
			animation-delay: 0.35s;
		}
		.ck-sheet :global([data-layer='DIMENSIONS'] [pathLength]) {
			animation-delay: 0.6s;
		}
		.ck-sheet :global(text) {
			opacity: 0;
			animation: ck-fade 0.4s var(--ck-ease) 1s forwards;
		}
	}
	@keyframes ck-draw {
		90% {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes ck-fill {
		to {
			fill-opacity: 1;
		}
	}
	@keyframes ck-fade {
		to {
			opacity: 1;
		}
	}

	.ck-readout {
		margin-top: var(--ck-space-3);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--ck-muted);
	}
	.ck-readout dl {
		display: flex;
		flex-wrap: wrap;
		gap: var(--ck-space-1) var(--ck-space-4);
		margin: 0;
	}
	.ck-readout dl > div {
		display: flex;
		gap: var(--ck-space-2);
	}
	.ck-readout dt {
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.ck-readout dd {
		margin: 0;
		color: var(--ck-text);
	}
	.ck-readout p {
		margin: var(--ck-space-2) 0 0;
	}
	.ck-readout code {
		color: var(--ck-text);
		font-size: inherit;
		background: none;
		padding: 0;
	}
</style>
