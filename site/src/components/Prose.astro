---
// Long-form text on hand-written pages, styled exactly like the docs (Starlight markdown styles).
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['sl-markdown-content', 'ck-prose', className]}><slot /></div>

<style>
	.ck-prose {
		max-width: 45rem;
	}
</style>
