---
// Status as icon + text (never colour alone).
import type { Status } from '../lib/types';
interface Props {
	status: Status;
	label: string;
}
const { status, label } = Astro.props;
---

<span class:list={['ck-chip', `ck-chip--${status}`]}>
	<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
		{status === 'ok' && <path d="M1.5 6.5 4.5 9.5 10.5 2.5" fill="none" stroke="currentColor" stroke-width="1.75" />}
		{status === 'partial' && (
			<>
				<rect x="1" y="1" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
				<path d="M1 11 11 1V11Z" fill="currentColor" />
			</>
		)}
		{status === 'pending' && <rect x="1.75" y="1.75" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 1.5" />}
	</svg>
	<span>{label}</span>
</span>

<style>
	.ck-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.125rem 0.5rem;
		border: 1px solid currentColor;
		border-radius: var(--ck-radius);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-2xs);
		line-height: 1.5;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
	.ck-chip svg {
		width: 0.75rem;
		height: 0.75rem;
		flex: none;
	}
	.ck-chip--ok {
		color: var(--ck-ok);
	}
	.ck-chip--partial {
		color: var(--ck-partial);
	}
	.ck-chip--pending {
		color: var(--ck-pending);
	}
</style>
