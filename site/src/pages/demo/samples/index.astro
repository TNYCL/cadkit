---
// /demo/samples/: every file the demo offers, with its origin, licence and checksum. Facts (size,
// SHA-256, format, counts) come from src/demo/generated/samples.json, written at build time by
// scripts/prebuild.d/10-samples.mjs after reading each file with cadkit-wasm.
import PageLayout from '../../../layouts/PageLayout.astro';
import Callout from '../../../components/Callout.astro';
import { SAMPLES, blobUrl, licenseHref } from '../../../demo/samples';
import facts from '../../../demo/generated/samples.json';
import { formatBytes, formatWithVersion, plural } from '../../../demo/text';
import { REPO } from '../../../config';

const factOf = (id: string) => {
	const f = (facts.samples as Record<string, (typeof facts.samples)['plan-dxf'] | undefined>)[id];
	if (!f) throw new Error(`no build facts for sample ${id}: run scripts/prebuild.d/10-samples.mjs`);
	return f;
};
const rows = SAMPLES.map((s) => ({ s, f: factOf(s.id) }));
const own = rows.filter((r) => !r.s.upstream);
const third = rows.filter((r) => r.s.upstream);

const title = 'Demo samples';
const description =
	'The drawings offered in the cadkit demo: our own synthetic DXF and CityGML samples and MIT-licensed DWG and DGN test files, with sources, licences and SHA-256.';
---

<PageLayout
	title={title}
	description={description}
	breadcrumbs={[{ label: 'Demo', href: '/demo/' }, { label: 'Samples' }]}
	eyebrow="Demo · sources and licences"
	lead="Every file the viewer demo offers, where it comes from, under which licence, and the checksum the build verifies."
	noAnalytics
>
	<section class="ck-container ck-samples" aria-labelledby="ck-s-own">
		<Callout title="No client or confidential drawings">
			<p>
				The demo uses only drawings we made ourselves and test files that open-source projects publish under the MIT
				licence. Nothing here comes from a client, a company or a private collection. Files you open in the demo stay in
				your browser.
			</p>
		</Callout>

		<h2 id="ck-s-own">Our samples</h2>
		<p>
			Generated by scripts in this repository, deterministically, and committed. Licensed like cadkit:
			MIT OR Apache-2.0.
		</p>
		<div class="ck-table-wrap" role="region" aria-labelledby="ck-s-own" tabindex="0">
			<table>
				<thead>
					<tr>
						<th scope="col">Sample</th>
						<th scope="col">Format</th>
						<th scope="col">Size</th>
						<th scope="col">Contents</th>
						<th scope="col">Source</th>
						<th scope="col"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					{
						own.map(({ s, f }) => (
							<tr id={s.id}>
								<th scope="row">
									<span class="ck-sname">{s.label}</span>
									<code class="ck-sid">{s.id}</code>
								</th>
								<td class="ck-fmtcol" data-label="Format">
									{formatWithVersion(f.format, f.version)}
								</td>
								<td class="ck-num" data-label="Size">{formatBytes(f.bytes)}</td>
								<td>
									<p>{s.description}</p>
									<p class="ck-sfacts">
										{plural(f.entities, 'entity', 'entities')} · {plural(f.layers, 'layer')} · {plural(f.warnings, 'warning')}
									</p>
									<p class="ck-hash">
										<span>SHA-256</span> <code>{f.sha256}</code>
									</p>
								</td>
								<td class="ck-src" data-label="Source">
									<a href={`${REPO}/blob/main/site/${s.generator}`}>{s.generator?.split('/').pop()}</a>
									<span class="ck-lic">{s.license}</span>
								</td>
								<td class="ck-actions">
									<a class="ck-btn ck-btn--primary" href={`/demo/?sample=${s.id}`}>
										Open in demo<span class="sr-only">: {s.label}</span>
									</a>
									<a href={s.path} download>
										Download<span class="sr-only"> {s.label}</span>
									</a>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<h2 id="ck-s-third">Third-party test files</h2>
		<p>
			Fetched at build time from a pinned upstream commit and checked against the SHA-256 below; the build stops on any
			other content. They are not stored in the cadkit repository. Each is served with the full licence text of its
			project.
		</p>
		<div class="ck-table-wrap" role="region" aria-labelledby="ck-s-third" tabindex="0">
			<table>
				<thead>
					<tr>
						<th scope="col">Sample</th>
						<th scope="col">Format</th>
						<th scope="col">Size</th>
						<th scope="col">Contents</th>
						<th scope="col">Source</th>
						<th scope="col"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					{
						third.map(({ s, f }) => {
							const u = s.upstream!;
							return (
								<tr id={s.id}>
									<th scope="row">
										<span class="ck-sname">{s.label}</span>
										<code class="ck-sid">{s.id}</code>
									</th>
									<td class="ck-fmtcol" data-label="Format">
										{formatWithVersion(f.format, f.version)}
									</td>
									<td class="ck-num" data-label="Size">{formatBytes(f.bytes)}</td>
									<td>
										<p>{s.description}</p>
										<p class="ck-sfacts">
											{plural(f.entities, 'entity', 'entities')} · {plural(f.layers, 'layer')} · {plural(f.warnings, 'warning')}
											{Object.keys(f.warningCodes).length > 0 && (
												<>
													{' '}
													({Object.entries(f.warningCodes).map(([c, n], i) => (
														<>
															{i > 0 && ', '}
															<code>{c}</code> × {n}
														</>
													))}
													)
												</>
											)}
										</p>
										<p class="ck-hash">
											<span>SHA-256</span> <code>{f.sha256}</code>
										</p>
									</td>
									<td class="ck-src" data-label="Source">
										<a href={blobUrl(u)}>
											{u.repo}/{u.path}
										</a>
										<span class="ck-commit">
											at commit <code>{u.commit.slice(0, 12)}</code>
										</span>
										<span class="ck-lic">
											{s.license} · <a href={licenseHref(u)}>licence text<span class="sr-only"> for {s.label}</span></a>
										</span>
									</td>
									<td class="ck-actions">
										<a class="ck-btn ck-btn--primary" href={`/demo/?sample=${s.id}`}>
											Open in demo<span class="sr-only">: {s.label}</span>
										</a>
										<a href={s.path} download>
											Download<span class="sr-only"> {s.label}</span>
										</a>
									</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
		<p class="ck-footnote">
			Counts and warnings are what cadkit-wasm {facts.cadkitWasmVersion} reports when the site is built. Warnings use
			cadkit's stable codes; a warning means the reader kept going past something it does not model.
		</p>
	</section>
</PageLayout>

<style>
	.ck-samples h2 {
		margin: var(--ck-space-12) 0 var(--ck-space-2);
	}
	.ck-samples > p {
		max-width: 46rem;
		color: var(--ck-muted);
	}
	.ck-table-wrap {
		margin-top: var(--ck-space-4);
		overflow-x: auto;
		border: 1px solid var(--ck-border);
		background: var(--ck-surface);
	}
	table {
		width: 100%;
		min-width: 60rem;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	thead th {
		padding: var(--ck-space-2) var(--ck-space-3);
		border-bottom: 1px solid var(--ck-border);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-align: left;
		text-transform: uppercase;
		color: var(--ck-muted);
	}
	tbody :is(th, td) {
		padding: var(--ck-space-3);
		vertical-align: top;
		text-align: left;
	}
	tbody tr + tr :is(th, td) {
		border-top: 1px solid var(--ck-border);
	}
	tbody th {
		font-weight: 600;
		width: 11rem;
	}
	.ck-sname {
		display: block;
	}
	.ck-sid {
		display: inline-block;
		margin-top: var(--ck-space-1);
		font-size: var(--sl-text-xs);
		font-weight: 400;
		color: var(--ck-muted);
	}
	td p {
		margin: 0;
	}
	td p + p {
		margin-top: var(--ck-space-1);
	}
	.ck-num {
		white-space: nowrap;
		font-family: var(--__sl-font-mono);
		font-variant-numeric: tabular-nums;
	}
	.ck-sfacts,
	.ck-hash {
		font-size: var(--sl-text-xs);
		color: var(--ck-muted);
	}
	.ck-hash code {
		font-size: var(--sl-text-2xs);
		overflow-wrap: anywhere;
		word-break: break-all;
		color: var(--ck-text);
	}
	.ck-hash span {
		font-family: var(--__sl-font-mono);
		letter-spacing: 0.04em;
	}
	.ck-commit,
	.ck-lic {
		display: block;
		margin-top: var(--ck-space-1);
		font-size: var(--sl-text-xs);
		color: var(--ck-muted);
	}
	td a {
		overflow-wrap: anywhere;
	}
	.ck-actions {
		width: 10rem;
	}
	.ck-src {
		width: 14rem;
	}
	.ck-fmtcol {
		width: 7.5rem;
	}
	.ck-samples {
		min-width: 0;
	}
	@media (max-width: 50rem) {
		.ck-table-wrap {
			overflow: visible;
		}
		table,
		tbody,
		tr,
		tbody :is(th, td) {
			display: block;
			width: auto;
			min-width: 0;
		}
		thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		tbody :is(th, td) {
			padding: var(--ck-space-1) var(--ck-space-4);
		}
		tbody th {
			padding-top: var(--ck-space-4);
		}
		tbody td:last-child {
			padding-bottom: var(--ck-space-4);
		}
		tbody tr + tr :is(td) {
			border-top: 0;
		}
		td[data-label]::before {
			content: attr(data-label) ' ';
			font-family: var(--__sl-font-mono);
			font-size: var(--sl-text-2xs);
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--ck-muted);
		}
		.ck-actions {
			display: flex !important;
			align-items: center;
			gap: var(--ck-space-4);
		}
		.ck-actions .ck-btn {
			margin: 0;
		}
	}
	.ck-actions .ck-btn {
		margin-bottom: var(--ck-space-2);
	}
	.ck-actions a:not(.ck-btn) {
		display: block;
		font-size: var(--sl-text-xs);
	}
	.ck-samples code {
		background: none;
		padding: 0;
		border: 0;
	}
	.ck-footnote {
		margin-top: var(--ck-space-4);
		font-size: var(--sl-text-xs);
	}
	.ck-samples :global(.ck-callout) {
		margin-top: 0;
		max-width: 46rem;
	}
</style>
